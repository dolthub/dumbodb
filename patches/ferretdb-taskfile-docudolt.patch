--- a/Taskfile.yml
+++ b/Taskfile.yml
@@ -212,6 +212,9 @@ tasks:
   test-integration:
     desc: "Run integration tests in parallel"
-    deps: [test-integration-postgresql, test-integration-mongodb]
+    deps: [test-integration-postgresql, test-integration-mongodb, test-integration-docudolt]
+
+  test-integration-docudolt:
+    desc: "Run integration tests against Docudolt (Dolt-backed MongoDB-compatible server)"
+    deps: [gen-version, test-integration-build]
+    dir: integration
+    vars:
+      DOCUDOLT_URL: '{{.DOCUDOLT_URL | default "mongodb://127.0.0.1:27017/"}}'
+    cmds:
+      - >
+        ../bin/envtool{{exeExt}} tests run
+        --shard-index={{.SHARD_INDEX}}
+        --shard-total={{.SHARD_TOTAL}}
+        --run='{{.TEST_RUN}}'
+        --skip='{{.TEST_SKIP}}'
+        --raw-prefix=docudolt-{{.SHARD_INDEX}}-{{.SHARD_TOTAL}}
+        --
+        -count=1
+        -timeout={{.TEST_TIMEOUT}}
+        {{.RACE_FLAG}}
+        -tags={{.BUILD_TAGS}}
+        -shuffle=on
+        -coverpkg=../...
+        -coverprofile=integration-docudolt.txt
+        ./...
+        -target-backend=ferretdb
+        -target-url='{{.DOCUDOLT_URL}}'
+        -compat-url='mongodb://username:password@127.0.0.1:47017/?replicaSet=rs0'
+        -no-xfail={{.NO_XFAIL}}
